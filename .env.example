# SafeHer AI - Environment Variables Configuration
# =================================================
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real API keys to version control.

# -------------------------------------------------------------------
# Google Maps Platform APIs (Optional - enables real-time routing)
# -------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis
# Enable the following APIs for your key:
#   - Maps SDK for Android
#   - Directions API
#   - Places API
#   - Geocoding API
GOOGLE_MAPS_API_KEY=

# -------------------------------------------------------------------
# Firebase Configuration (Optional - enables auth and Firestore)
# -------------------------------------------------------------------
# Create a project at: https://console.firebase.google.com
# Enable: Email/Password Authentication, Cloud Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
# Alternatively, supply raw JSON credentials in an environment variable (useful on Render/cloud platforms):
FIREBASE_CREDENTIALS_JSON=

# -------------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------------
# Change this to a strong random secret in production
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_EXPIRATION_HOURS=72

# -------------------------------------------------------------------
# CORS Allowed Origins
# -------------------------------------------------------------------
# Comma-separated list of allowed origins (leave empty for development defaults)
ALLOWED_ORIGINS=

# -------------------------------------------------------------------
# Backend Server
# -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True

